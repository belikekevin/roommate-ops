# Copy to .env and fill in. Never commit .env.
# Required to boot: DATABASE_URL, the LLM gateway pair, TELEGRAM_BOT_TOKEN. Everything else is optional
# and only switches a feature on (voice notes, email, chat buttons, dashboard password).

# ---------- Database ----------
# Postgres (app data + Mastra memory tables). Neon works; use the pooled connection string.
DATABASE_URL=postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/roommate_ops?sslmode=require

# ---------- LLM ----------
# Neon AI Gateway through Mastra's model router ("neon/<id>", see src/lib/llm.ts).
# Neon Console -> branch -> Connect -> "AI Gateway" tab. Base URL is the bare host (no /v1);
# the token is the gateway credential from "Reveal credential" (scope ai_gateway:invoke), NOT a napi_ API key.
# Model ids must be in the branch catalog: curl "$NEON_AI_GATEWAY_BASE_URL/v1/models" -H "Authorization: Bearer $NEON_AI_GATEWAY_TOKEN"
NEON_AI_GATEWAY_BASE_URL=https://br-xxxx-api.ai.c-2.us-east-2.aws.neon.tech
NEON_AI_GATEWAY_TOKEN=
LLM_MODEL=claude-sonnet-5

# ---------- Voice notes (optional) ----------
# Telegram voice notes -> text via OpenRouter: an audio-capable chat model transcribes the note.
# Without OPENROUTER_API_KEY, voice notes are not answered; text still works.
OPENROUTER_API_KEY=
STT_MODEL=google/gemini-2.5-flash

# ---------- Telegram ----------
# @BotFather: /newbot for the token and username, then /setprivacy -> Disable so Kevin sees every group message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_bot_username
# Any string of A-Z a-z 0-9 _ - (1-256 chars). Telegram sends it with every webhook call.
TELEGRAM_WEBHOOK_SECRET=change-me
# Seed only: your group's chat id (-100...). Binds the seeded house to the group so Kevin can post unprompted.
TELEGRAM_CHAT_ID=

# ---------- Email (optional) ----------
# AgentMail: Kevin's inbox. Without AGENTMAIL_API_KEY, the email tools return a clear "not configured" error.
AGENTMAIL_API_KEY=
# Kevin's inbox address. The seed writes it into a newly created demo house, and it is the fallback "from"
# address for a house that has no inbox of its own (Roommates -> House settings sets it per house).
AGENTMAIL_INBOX=kevin@agentmail.to
# Only if you register an AgentMail webhook at $APP_URL/api/agentmail: the webhook's signing secret ("whsec_...").
# When set, every delivery must carry a valid signature. When unset, the signature is not checked.
# The webhook itself is optional: the scheduler polls the inbox once a minute anyway.
AGENTMAIL_WEBHOOK_SECRET=
# Seed only: the leasing office address written into a newly created demo house. Defaults to leasing@example.com.
LEASING_EMAIL=

# ---------- App ----------
# Public URL of the app: Telegram webhook target and the base for the buttons in Kevin's replies.
# Locally you can leave it as is or use http://localhost:3000; buttons are only attached for absolute http(s) URLs.
APP_URL=https://your-app.fly.dev
# When set, the dashboard and /api/chat require HTTP Basic auth (any username, this password).
# The Telegram and AgentMail webhooks stay open; they have their own secrets (above). Unset = no auth.
# Set it for any deployment that is reachable from the internet.
DASHBOARD_PASSWORD=
# Set to 1 to skip the in-process scheduler (reminders, weekly report, upkeep nudge, inbox poll).
# Use it on any extra instance, and locally if a deployed instance already runs the scheduler on the same database.
# DISABLE_SCHEDULER=1
# Scripts only: pick the household that `npm run seed` / `npm run kevin:smoke` act on. Default: the first one.
# KEVIN_HOUSEHOLD_ID=
